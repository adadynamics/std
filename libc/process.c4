use std::string as string
use std::libc::socket as sock



type int         = i32
type uint        = u32
type long        = i64
type ulong       = u64
type size_t      = u64
type ssize_t     = i64
type gid_t       = i32
type uid_t       = i32
type pid_t       = i32
type id_t        = i32
type rlim_t      = u32
type clock_t     = i64
type time_t      = i32
type suseconds_t = i32

struct Rlimit{
    rlim_t rlim_cur  // Soft Limit
    rlim_t rlim_max  // Hard Limit
}


struct Timeval{
    time_t tv_sec       // Seconds
    suseconds_t tv_usec // Microseconds
}


struct Rusage{
    Timeval ru_utime   // User CPU time used
    Timeval ru_stime   // System CPU time used
    long ru_maxrss     // Maximum resident set size
    long ru_ixrss      // Integral shared memory size
    long ru_idrss      // Integral unshared data size
    long ru_isrss      // Integral unshared stack size
    long ru_minflt     // Page reclaims (soft page faults)
    long ru_majflt     // Page faults (hard page faults)
    long ru_nswap      // Swaps
    long ru_inblock    // Block input operations
    long ru_outblock   // Block output operations
    long ru_msgsnd     // IPC messages sent
    long ru_msgrcv     // IPC messages received
    long ru_nsignals   // Signals received
    long ru_nvcsw      // Voluntary context switches
    long ru_nivcsw     // Involuntary context switches
}

struct Iovec{
    void *iov_base    // Starting address
    size_t iov_len    // Size of the memory pointed to by iov_base
}

struct Tms{
    clock_t tms_utime  // User Time
    clock_t tms_stime  // System Time
    clock_t tms_cutime // User Time of children
    clock_t tms_cstime // System TIme of children
}


foreign "C"{
    fn execve(str pathname, str *argv,str *envp)->int

    fn execveat(int dirfd,str pathname, str *argv,str *envp,int flags)->int

    fn exit(int status)

    fn exit_group(int status)->int

    fn fork()->int

    fn vfork()->int

    fn getcpu(uint *cpu,uint *node)->int

    fn getegid()->int

    fn geteuid()->int

    fn getgid()->int

    fn getgroups(int size,gid_t *list)->int

    fn getpgid(pid_t pid)->int

    fn getpgrp()->int

    fn getpid()->int

    fn getppid()->int

    fn getpriority(int which,id_t who)->int

    fn getresgid(gid_t *rgid,gid_t *egid,gid_t *sgid)->int

    fn getresuid(uid_t *ruid,uid_t *euid,uid_t *suid)->int
    
    fn getrlimit(int resource,Rlimit *rlim)->int

    fn getrusage(int who,Rusage *usage)->int

    fn getsid(pid_t pid)->int

    fn gettid()->int

    fn getuid()->int

    fn kill(pid_t pid,int sig)->int

    fn pidfd_getfd(int pidfd,int targetfd,uint flags)->int

    fn pidfd_open(pid_t pid,uint flags)->int

    fn prctl(int op,ulong arg2,ulong arg3,ulong arg4, ulong arg5)->int

    fn prlimit(pid_t pid, int resource,Rlimit *new_limit,Rlimit *old_limit)->int

    fn process_madvise(int pidfd,Iovec *iovec,size_t n,int advice,uint flags)->int

    fn process_vm_readv(pid_t pid,Iovec *local_iov,ulong liovcnt,Iovec *remote_iov,ulong riovcnt,ulong flags)->i64

    fn process_vm_writev(pid_t pid,Iovec *local_iov,ulong liovcnt,Iovec *remote_iov,ulong riovcnt,ulong flags)->i64

    fn setgid(gid_t gid)->int

    fn setgroups(size_t size,gid_t *list)->int

    fn initgroups(str user,gid_t group)->int

    fn setns(int fd,int nstype)->int

    fn setpgid(pid_t pid, pid_t pgid)->int

    fn setpriority(int which,id_t who, int prio)->int

    fn setregid(gid_t rgid, gid_t egid)->int

    fn setresgid(gid_t rgid,gid_t egid,gid_t sgid)->int

    fn setresuid(uid_t ruid,uid_t euid,uid_t suid)->int

    fn setreuid(uid_t ruid,uid_t euid)->int

    fn setrlimit(int resource,Rlimit *rlim)->int

    fn setsid()->int

    fn set_tid_address(int *tidptr)->int

    fn setuid(uid_t uid)->int

    fn seteuid(uid_t uid)->int

    fn setegid(gid_t gid)->int

    fn tgkill(pid_t tgid,pid_t tid,int sig)->int

    fn unshare(int flags)->int

    fn wait(int *status)->int

    fn waitpid(pid_t pid,int *status,int options)->int

    fn wait4(pid_t pid,int *wstatus,int options,Rusage *rusage)->int

    fn wait3(int *wstatus,int options,Rusage *rusage)->int

    fn modify_ldt(int func,void *ptr,ulong bytecount)->int

    fn seccomp(uint operation,uint flags,void *args)->int

    fn kcmp(pid_t pid1,pid_t pid2,int _type,ulong idx1,ulong idx2)->int

    fn getenv(str name)->str 

    fn setenv(str name,str value,int overwrite)->int

    fn unsetenv(str name)->int

    fn clearenv()->int

    fn times(Tms *buf)->int

    fn acct(str acctfile)->int

}



fn Execve(str pathname,str *argv,str *envp)->sock::Result{
    i64 result = execve(pathname,argv,envp)

    if result < 0{
        return sock::Result::Err("Execve Failed")
    }

    return sock::Result::Ok(result)
}



fn Execveat(int dirfd,str pathname,str *argv,str *envp,int flags)->sock::Result{
    i64 result = execveat(dirfd,pathname,argv,envp,flags)

    if result < 0{
        return sock::Result::Err("Execveat Failed")
    }

    return sock::Result::Ok(result)
}



// libc doesn't provide a wrapper for it
fn ExitGroup(int status)->sock::Result{
    i64 result //= exit_group(status)

    if result < 0{
        return sock::Result::Err("ExitGroup Failed")
    }

    return sock::Result::Ok(result)
}


fn Exit(int status)->sock::Result{
    exit(status)

    return sock::Result::Ok(0)
}



fn Fork()->sock::Result{
    i64 result = fork()

