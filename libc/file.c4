use std::string as string
use std::libc::socket as sock


type uchar       = u8
type short       = i16
type ushort      = u16
type int         = i32
type uint        = u32
type long        = i64
type ulong       = u64
type size_t      = u64
type ssize_t     = i64
type gid_t       = i32
type uid_t       = i32
type pid_t        = i32
type id_t         = i32
type rlim_t       = u32
type clock_t      = i64
type time_t       = i32
type suseconds_t  = i32
type key_serial_t = i32
type off_t        = i64
type intptr_t     = i64
type mode_t       = i32
type dev_t        = i32
type ino_t        = u64
type DIR          = void



struct timespec{
    i64 tv_sec
    i64 tv_nsec
}

enum FileTypeMask{
    S_IFMT = 0xf000
}

enum DirectoryFlag{
    S_IFDIR = 0x4000
}

struct stat{
    u64 st_dev
    u64 st_ino

    u64 st_nlink
    u32 st_mode

    u32 st_uid
    u32 st_gid

    i32 __pad0

    u64 st_rdev
    i64 st_size
    i64 st_blksize
    i64 st_blocks

    timespec st_atim
    timespec st_mtim
    timespec st_ctim

    i64 __glibc_reserved0
    i64 __glibc_reserved1
    i64 __glibc_reserved2
}


impl stat{
    fn GetDevice()->u64{
        return self->st_dev
    }

    fn GetInodeNumber()->u64{
        return self->st_ino
    }

    fn GetMode()->u64{
        return self->st_mode
    }

    fn IsDirectory()->u32{
        return (self->st_mode & FileTypeMask::S_IFMT) == DirectoryFlag::S_IFDIR
    }

    fn GetLinkCount()->u64{
        return self->st_nlink
    }

    fn GetUserID()->u64{
        return self->st_uid
    }

    fn GetGroupID()->u64{
        return self->st_gid
    }

    fn GetDeviceID()->u64{
        return self->st_rdev
    }

    fn GetSize()->i64{
        return self->st_size
    }

    fn GetBlockSize()->i64{
        return self->st_blksize
    }

    fn GetBlockCount()->i64{
        return self->st_blocks
    }

    fn GetAccessTime()->timespec{
        return self->st_atim
    }

    fn GetModificationTime()->timespec{
        return self->st_mtim
    }

    fn GetChangeTime()->timespec{
        return self->st_ctim
    }
}



struct Pollfd{
    int fd        // File descriptor
    short events  // Requested events
    short revents // returned events
}


struct Iovec{
    void *iov_base    // Starting address
    size_t iov_len    // Size of the memory pointed to by iov_base
}


struct Dirent{
    ino_t  d_ino     // Inode number
    off_t  d_off     // Not an offset; see below
    ushort d_reclen  // Length of this record
    uchar  d_type    // Type of file; not supported by all filesystem types
    char [256]d_name // Null-terminated filename
}

impl Dirent{
    fn GetInodeNumber()->ino_t{
        return self->d_ino
    }


    fn GetRecordLength()->ushort{
        return self->d_reclen
    }

    fn GetType()->uchar{
        return self->d_type
    }

    fn GetName()->str{
        return self->d_name as str
    }
}


