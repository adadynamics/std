enum OpenFlag{
    O_RDONLY = 0
    O_WRONLY = 1
    O_CREAT  = 64
    O_TRUNC  = 512
}


fn Open(i8 *name,i32 flags,i32 mode)->sock::Result{
    i64 result = open(name,flags,mode)

    if result < 0{
        return sock::Result::Err("Open Failed")
    }

    return sock::Result::Ok(result)
}



fn Creat(i8 *name,i32 mode)->sock::Result{
    i64 result = creat(name,mode)

    if result < 0{
        return sock::Result::Err("Creat Failed")
    }

    return sock::Result::Ok(result)
}



fn Openat(i32 dirfd,i8 *name,i32 flags,i32 mode)->sock::Result{
    i64 result = openat(dirfd,name,flags,mode)

    if result < 0{
        return sock::Result::Err("OpenAt Failed")
    }

    return sock::Result::Ok(result)
}



fn Read(i32 fd,void *buf,u64 buflen)->sock::Result{
    i64 result = read(fd,buf,buflen)

    if result < 0{
        return sock::Result::Err("Read failed")
    }

    return sock::Result::Ok(result)
}



fn Write(i32 fd,void *buf,u64 buflen)->sock::Result{
    i64 result = write(fd,buf,buflen)

