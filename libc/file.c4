fn Mount(char *source,char *target,char *fs_type,ulong mount_flags,void *data)->sock::Result{
    i64 result = mount(source,target,fs_type,mount_flags,data)

    if result < 0{
        return sock::Result::Err("Mount Failed")
    }

    return sock::Result::Ok(result)
}



