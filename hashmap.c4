use std::memory::allocators::bump as allocator
use std::libc::memory as memory
use std::libc::socket as socket


//  XXH64 constants
//
// These are carefully chosen prime numbers from the xxh64 specification.
// Do not change them.

const u64 XXH_PRIME64_1 = 11400714785074694791 as u64
const u64 XXH_PRIME64_2 = 14029467366897019727 as u64
const u64 XXH_PRIME64_3 = 1609587929392839161 as u64
const u64 XXH_PRIME64_4 = 9650029242287828579 as u64
const u64 XXH_PRIME64_5 = 2870177450012600261 as u64


//  HashNode

struct HashNode{
    void *key
    u64 keyLength
    void *value
    u64 hash
    HashNode *next  // forward chaining for collision handling
}


//  HashMap

struct HashMap{
    HashNode **buckets  // array of bucket heads, one per slot
    u64 capacity
    u64 size
    u64 seed
    allocator::BumpAllocator *bump
}


impl HashMap{
    fn Init(u64 capacity,allocator::BumpAllocator *bump){
        self->capacity = capacity
        self->seed     = 0
        self->size     = 0
        self->bump     = bump
        // Allocate the bucket array zeroed out so every head starts as null.
        // The bump allocator is expected to zero its memory; if it does not,
        // add an explicit memset here.
        self->buckets  = self->bump->AllocType(sizeof(HashNode*),capacity,alignof(HashNode*))
    }


    //  XXH64 helpers 

    // Safe unaligned u64 read via memcpy.
    // Avoids undefined behaviour from direct pointer casts on platforms
    // that enforce strict alignment.
    fn ReadU64(void *ptr)->u64{
        u64 val = 0
        memory::Memcpy(&val,ptr,8)
        return val
    }

    // Safe unaligned u32 read via memcpy.
    fn ReadU32(void *ptr)->u32{
        u32 val = 0
        memory::Memcpy(&val,ptr,4)
        return val
    }

    // Rotate a 64-bit value left by r bits.
    // Information is preserved across the rotation boundary, which is
    // essential for the avalanche behaviour of xxh64.
    fn RotateLeft64(u64 x,u64 r)->u64{
        return (x << r) | (x >> (64 - r))
    }

    // Core mixing step used throughout xxh64.
    // Multiplies input by a large prime, adds to the accumulator,
    // rotates, then multiplies again to spread entropy.
    fn XXH64Round(u64 acc,u64 input)->u64{
        acc += input * XXH_PRIME64_2
        acc  = self->RotateLeft64(acc,31)
        acc *= XXH_PRIME64_1
        return acc
    }

    // Full xxh64 implementation.
    // See the header comment in the C source for a detailed breakdown of
    // each phase: bulk processing, accumulator merge, tail processing, and
    // final avalanche.
    fn XXH64(void *input,u64 len,u64 seed)->u64{
        u8 *p   = input
        u8 *end = p + len
        u64 h64 = 0

        if len >= 32{
            //  bulk processing 
            // Four independent accumulators processed in 32-byte stripes
            // (4 x 8 bytes) for instruction-level parallelism.
            u8 *limit = end - 32

            u64 v1 = seed + XXH_PRIME64_1 + XXH_PRIME64_2
            u64 v2 = seed + XXH_PRIME64_2
            u64 v3 = seed + 0
            u64 v4 = seed - XXH_PRIME64_1

            while p <= limit{
                v1  = self->XXH64Round(v1,self->ReadU64(p))
                p  += 8
                v2  = self->XXH64Round(v2,self->ReadU64(p))
                p  += 8
                v3  = self->XXH64Round(v3,self->ReadU64(p))
                p  += 8
                v4  = self->XXH64Round(v4,self->ReadU64(p))
                p  += 8
            }

            //  accumulator merge 
            // Rotate each lane by a different amount then combine.
            // Each lane is then re-mixed with XXH64Round to preserve its
            // individual entropy before the lanes are collapsed together.
            h64  = self->RotateLeft64(v1,1)
            h64 += self->RotateLeft64(v2,7)
            h64 += self->RotateLeft64(v3,12)
            h64 += self->RotateLeft64(v4,18)

            h64 ^= self->XXH64Round(0,v1)
            h64 *= XXH_PRIME64_1

            h64 ^= self->XXH64Round(0,v2)
            h64 *= XXH_PRIME64_1

            h64 ^= self->XXH64Round(0,v3)
            h64 *= XXH_PRIME64_1

            h64 ^= self->XXH64Round(0,v4)
            h64 *= XXH_PRIME64_1
        }
        else{
            //  small-input path ─
            // For inputs under 32 bytes skip the parallel lanes and start
            // from a seed + prime base instead.
            h64 = seed + XXH_PRIME64_5
        }

        // Length is always mixed in so that inputs that are prefixes of each
        // other produce different hashes.
        h64 += len

        //  tail processing ─
        // Consume remaining bytes in descending chunk sizes so every byte
        // influences the final hash value.

        // 8-byte chunks
        while (p + 8) <= end{
            u64 k1  = self->XXH64Round(0,self->ReadU64(p))
            h64    ^= k1
            h64     = self->RotateLeft64(h64,27) * XXH_PRIME64_1 + XXH_PRIME64_4
            p      += 8
        }

        // 4-byte chunk
        // ISSUE: the C source casts ReadU32 result to u64 before multiplying.
        // Make sure your u32->u64 widening is implicit here; if not, add an
        // explicit cast.
        if (p + 4) <= end{
            h64 ^= (self->ReadU32(p) as u64) * XXH_PRIME64_1
            h64  = self->RotateLeft64(h64,23) * XXH_PRIME64_2 + XXH_PRIME64_3
            p   += 4
        }

        // Remaining individual bytes
        while p < end{
            u64 byte = p@read() as u64
            h64 ^= byte * XXH_PRIME64_5
            h64  = self->RotateLeft64(h64,11) * XXH_PRIME64_1
            p   += 1
        }

        //  final avalanche ─
        // XOR-shift and multiply sequence destroys any remaining structure
        // and ensures strong diffusion across all output bits.
        h64 ^= h64 >> 33
        h64 *= XXH_PRIME64_2
        h64 ^= h64 >> 29
        h64 *= XXH_PRIME64_3
        h64 ^= h64 >> 32

        return h64
    }


    //  public API 

    // Insert a key-value pair into the map.
    // Uses prepend-to-bucket (LIFO) insertion so the most recently inserted
    // value for a given key is found first on lookup.
    fn Add(void *key,u64 len,void *value)->u32{
        u64 hash = self->XXH64(key,len,self->seed)
        u64 idx  = hash % self->capacity

        HashNode *node = self->bump->AllocType(sizeof(HashNode),1,alignof(HashNode))

        if node == null{
            return 0
        }

        // Allocate a private copy of the key so the caller does not need to
        // keep the original buffer alive. Extra 2 bytes are zeroed for safety
        // in case the key is later used as a C string.
        node->key = self->bump->AllocType(1,len + 2,1)

        if node->key == null{
            return 0
        }

        memory::Memset(node->key,0,len + 2)
        memory::Memcpy(node->key,key,len)

        node->hash      = hash
        node->keyLength = len
        node->value     = value

        // Prepend to the bucket chain.
        node->next            = self->buckets[idx]
        self->buckets[idx]    = node
        self->size           += 1

        return 1
    }

    // Look up a key and return its associated value, or null if not found.
    // Both hash and key bytes are checked to handle collisions correctly.
    fn Get(void *key,u64 len)->void *{
        u64 hash      = self->XXH64(key,len,self->seed)
        u64 idx       = hash % self->capacity
        HashNode *node = self->buckets[idx]

        while node != null{
            i32 status            = 0
            socket::Result result = memory::Memcmp(node->key,key,len)

            match result{
                socket::Result::Ok(ok){
                    status = ok
                }
            }

            if node->keyLength == len and status == 0{
                return node->value
            }

            node = node->next
        }

        u64 a = 90
        a     ^= 90

        return null
    }
}

